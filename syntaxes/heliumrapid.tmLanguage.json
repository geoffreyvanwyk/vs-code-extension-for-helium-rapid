{
	"$schema": "https://www.schemastore.org/tmlanguage.json",
	"name": "heliumrapid",
	"scopeName": "source.heliumrapid",
	"displayName": "Helium Rapid",
	"description": "Textmate grammar for domain-specific language of the Helium Rapid application platform-as-a-service",
	"fileTypes": [
		"mez"
	],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#annotations"
		},
		{
			"include": "#units"
		},
		{
			"include": "#validators"
		},
		{
			"include": "#enums"
		},
		{
			"include": "#objects"
		},
		{
			"include": "#storage-types"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#member-expressions"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.heliumrapid",
					"match": "//.*$"
				},
				{
					"name": "comment.block.heliumrapid",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"name": "comment.block.heliumrapid",
							"match": "\\*/"
						}
					]
				}
			]
		},
		"units": {
			"patterns": [
				{
					"comment": "unit ShopMgmt;",
					"name": "meta.unit.heliumrapid",
					"match": "\\b(unit)\\s+([A-Z][A-Za-z0-9_]*)\\s*(;)",
					"captures": {
						"1": {
							"name": "keyword.declaration.unit.heliumrapid"
						},
						"2": {
							"name": "entity.name.namespace.heliumrapid"
						},
						"3": {
							"name": "punctuation.terminator.statement.heliumrapid"
						}
					}
				}
			]
		},
		"validators": {
			"patterns": [
				{
					"comment": "validator requiredFieldValidator { notnull(); }",
					"name": "meta.validator.heliumrapid",
					"begin": "\\b(validator)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.validator.heliumrapid"
						},
						"2": {
							"name": "entity.name.type.validator.heliumrapid"
						},
						"3": {
							"name": "punctuation.definition.block.begin.heliumrapid"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.end.heliumrapid"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#functions"
						},
						{
							"include": "#punctuation"
						}
					]
				}
			]
		},
		"enums": {
			"patterns": [
				{
					"name": "meta.enum.heliumrapid",
					"begin": "\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.enum.heliumrapid"
						},
						"2": {
							"name": "entity.name.type.enum.heliumrapid"
						},
						"3": {
							"name": "punctuation.definition.block.begin.heliumrapid"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.end.heliumrapid"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
							"name": "variable.other.enummember.heliumrapid"
						},
						{
							"match": ",",
							"name": "punctuation.separator.comma.heliumrapid"
						}
					]
				}
			]
		},
		"objects": {
			"patterns": [
				{
					"name": "meta.object.heliumrapid",
					"begin": "\\b(?:(persistent)\\s+)?(object)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
					"beginCaptures": {
						"1": {
							"name": "storage.modifier.heliumrapid"
						},
						"2": {
							"name": "keyword.declaration.object.heliumrapid"
						},
						"3": {
							"name": "entity.name.type.object.heliumrapid"
						},
						"4": {
							"name": "punctuation.definition.block.begin.heliumrapid"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.end.heliumrapid"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#annotations"
						},
						{
							"include": "#object-attributes"
						},
						{
							"include": "#keywords"
						},
						{
							"include": "#storage-types"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#operators"
						},
						{
							"include": "#member-expressions"
						},
						{
							"include": "#functions"
						},
						{
							"include": "#constants"
						},
						{
							"include": "#variables"
						},
						{
							"include": "#punctuation"
						}
					]
				}
			]
		},
		"object-attributes": {
			"patterns": [
				{
					"comment": "Attribute declaration: string name; STATES state; ShopOwner[] owners; __sms_result__ result;",
					"name": "meta.object.attribute.heliumrapid",
					"match": "\\b(?:(int|string|decimal|bigint|bool|date|datetime|uuid|blob|json|jsonarray)|([A-Z][A-Z0-9_]*)|([A-Z][a-zA-Z0-9]*[a-z][a-zA-Z0-9]*(?:\\[\\])?)|(__[a-z][a-z0-9_]*__(?:\\[\\])?))\\s+([a-z_][a-zA-Z0-9_]*)\\b",
					"captures": {
						"1": {
							"name": "storage.type.primitive.heliumrapid"
						},
						"2": {
							"name": "storage.type.enum.heliumrapid"
						},
						"3": {
							"name": "storage.type.object.heliumrapid"
						},
						"4": {
							"name": "storage.type.builtin.heliumrapid"
						},
						"5": {
							"name": "variable.other.property.heliumrapid"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.heliumrapid",
					"match": "\\b(if|else|for|foreach|throw|try|catch|finally|return)\\b"
				},
				{
					"name": "keyword.control.trigger.heliumrapid",
					"match": "\\b(beforeCreate|afterCreate|beforeUpdate|afterUpdate|beforeDelete|afterDelete)\\b"
				},
				{
					"name": "keyword.type.heliumrapid",
					"match": "\\b(object|enum|validator|unit)\\b"
				},
				{
					"name": "keyword.modifier.heliumrapid",
					"match": "\\b(persistent)\\b"
				},
				{
					"name": "keyword.other.heliumrapid",
					"match": "\\b(via)\\b"
				}
			]
		},
		"string-escapes": {
			"patterns": [
				{
					"name": "constant.character.escape.unicode.heliumrapid",
					"match": "\\\\u[0-9a-fA-F]{4}"
				},
				{
					"name": "constant.character.escape.unicode.heliumrapid",
					"match": "\\\\x[0-9a-fA-F]{2}"
				},
				{
					"name": "constant.character.escape.heliumrapid",
					"match": "\\\\."
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.heliumrapid",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#string-escapes"
						}
					]
				},
				{
					"name": "string.quoted.other.multiline.json.heliumrapid",
					"begin": "/%(?=\\s*[\\{\\[])",
					"end": "%/",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.heliumrapid"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.heliumrapid"
						}
					},
					"contentName": "meta.embedded.block.json",
					"patterns": [
						{
							"include": "source.json"
						}
					]
				},
				{
					"name": "string.quoted.other.multiline.heliumrapid",
					"begin": "/%",
					"end": "%/",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.heliumrapid"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.heliumrapid"
						}
					}
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.decimal.heliumrapid",
					"match": "\\b\\d+\\.\\d+\\b"
				},
				{
					"name": "constant.numeric.integer.bigint.heliumrapid",
					"match": "\\b\\d+l\\b"
				},
				{
					"name": "constant.numeric.integer.decimal.heliumrapid",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.increment.heliumrapid",
					"match": "\\+\\+|--"
				},
				{
					"name": "keyword.operator.arithmetic.heliumrapid",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.assignment.heliumrapid",
					"match": "="
				},
				{
					"name": "keyword.operator.comparison.heliumrapid",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.logical.heliumrapid",
					"match": "&&|\\|\\|"
				},
				{
					"name": "keyword.operator.member.heliumrapid",
					"match": "\\."
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"comment": "Inline SQL (same line): sql:query|execute(/% SELECT ... %/, ...)",
					"name": "meta.function-call.sql.heliumrapid",
					"begin": "\\b(sql)(:)(query|execute)\\s*(\\()\\s*(/%)",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.heliumrapid"
						},
						"2": {
							"name": "punctuation.separator.scope.heliumrapid"
						},
						"3": {
							"name": "entity.name.function.heliumrapid"
						},
						"4": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						},
						"5": {
							"name": "punctuation.definition.string.begin.heliumrapid"
						}
					},
					"end": "%/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.heliumrapid"
						}
					},
					"contentName": "meta.embedded.block.sql",
					"patterns": [
						{
							"include": "source.sql"
						}
					]
				},
				{
					"comment": "Inline SQL (same line): sql:query|execute(\"SELECT ...\", ...)",
					"name": "meta.function-call.sql.heliumrapid",
					"begin": "\\b(sql)(:)(query|execute)\\s*(\\()\\s*(\")",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.heliumrapid"
						},
						"2": {
							"name": "punctuation.separator.scope.heliumrapid"
						},
						"3": {
							"name": "entity.name.function.heliumrapid"
						},
						"4": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						},
						"5": {
							"name": "punctuation.definition.string.begin.heliumrapid"
						}
					},
					"end": "\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.heliumrapid"
						}
					},
					"contentName": "meta.embedded.block.sql",
					"patterns": [
						{
							"include": "#string-escapes"
						},
						{
							"include": "source.sql"
						}
					]
				},
				{
					"comment": "Inline SQL (string after newline): sql:query|execute(\\n/% ... %/|\"...\"). Begin cannot span lines. Abort if the first arg is not a string.",
					"name": "meta.function-call.sql.heliumrapid",
					"begin": "\\b(sql)(:)(query|execute)\\s*(\\()[ \\t]*$",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.heliumrapid"
						},
						"2": {
							"name": "punctuation.separator.scope.heliumrapid"
						},
						"3": {
							"name": "entity.name.function.heliumrapid"
						},
						"4": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						}
					},
					"end": "(?<=%/)|(?<=\")|(?=\\s*[a-zA-Z_\\)])",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"begin": "/%",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.heliumrapid"
								}
							},
							"end": "%/",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.heliumrapid"
								}
							},
							"contentName": "meta.embedded.block.sql",
							"patterns": [
								{
									"include": "source.sql"
								}
							]
						},
						{
							"begin": "\"",
							"beginCaptures": {
								"0": {
									"name": "punctuation.definition.string.begin.heliumrapid"
								}
							},
							"end": "\"",
							"endCaptures": {
								"0": {
									"name": "punctuation.definition.string.end.heliumrapid"
								}
							},
							"contentName": "meta.embedded.block.sql",
							"patterns": [
								{
									"include": "#string-escapes"
								},
								{
									"include": "source.sql"
								}
							]
						}
					]
				},
				{
					"comment": "Scoped call / BIF: String:concat(, Shop:new(, Mez:log(",
					"name": "meta.function-call.scoped.heliumrapid",
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
					"captures": {
						"1": {
							"name": "entity.name.type.heliumrapid"
						},
						"2": {
							"name": "punctuation.separator.scope.heliumrapid"
						},
						"3": {
							"name": "entity.name.function.heliumrapid"
						},
						"4": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						}
					}
				},
				{
					"comment": "Declaration: void init(, string getName(, Shop[] getShops(, __sms_result__[] getSmsResults(",
					"name": "meta.function.definition.heliumrapid",
					"begin": "\\b(?:(void|int|string|decimal|bigint|bool|date|datetime|uuid|blob|json|jsonarray)|([A-Z][A-Z0-9_]*)|([A-Z][a-zA-Z0-9]*[a-z][a-zA-Z0-9]*(?:\\[\\])?)|(__[a-z][a-z0-9_]*__(?:\\[\\])?))\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
					"beginCaptures": {
						"1": {
							"name": "storage.type.primitive.heliumrapid"
						},
						"2": {
							"name": "storage.type.enum.heliumrapid"
						},
						"3": {
							"name": "storage.type.object.heliumrapid"
						},
						"4": {
							"name": "storage.type.builtin.heliumrapid"
						},
						"5": {
							"name": "entity.name.function.heliumrapid"
						},
						"6": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						}
					},
					"end": "\\)",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.parameters.end.heliumrapid"
						}
					},
					"patterns": [
						{
							"include": "#storage-types"
						},
						{
							"include": "#variables"
						},
						{
							"name": "punctuation.separator.comma.heliumrapid",
							"match": ","
						}
					]
				},
				{
					"comment": "Ordinary call: init(, notnull(, save(",
					"name": "meta.function-call.heliumrapid",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.heliumrapid"
						},
						"2": {
							"name": "punctuation.definition.parameters.begin.heliumrapid"
						}
					}
				}
			]
		},
		"member-expressions": {
			"patterns": [
				{
					"comment": "Trigger context: before.field, after.field",
					"name": "meta.member-expression.trigger.heliumrapid",
					"begin": "\\b(before|after)(?=\\s*\\.[a-zA-Z_])",
					"beginCaptures": {
						"1": {
							"name": "variable.language.trigger.heliumrapid"
						}
					},
					"end": "(?!\\s*\\.[a-zA-Z_])",
					"patterns": [
						{
							"match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
							"captures": {
								"1": {
									"name": "punctuation.accessor.heliumrapid"
								},
								"2": {
									"name": "variable.other.property.heliumrapid"
								}
							}
						}
					]
				},
				{
					"comment": "a.b, a.b.c(), request.headers.jsonPut(",
					"name": "meta.member-expression.heliumrapid",
					"begin": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\.[a-zA-Z_])",
					"beginCaptures": {
						"1": {
							"name": "variable.other.object.heliumrapid"
						}
					},
					"end": "(?!\\s*\\.[a-zA-Z_])",
					"patterns": [
						{
							"comment": "Method segment: .jsonPut(",
							"name": "meta.function-call.instance.heliumrapid",
							"match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
							"captures": {
								"1": {
									"name": "punctuation.accessor.heliumrapid"
								},
								"2": {
									"name": "entity.name.function.heliumrapid"
								}
							}
						},
						{
							"comment": "Property segment: .headers",
							"match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
							"captures": {
								"1": {
									"name": "punctuation.accessor.heliumrapid"
								},
								"2": {
									"name": "variable.other.property.heliumrapid"
								}
							}
						}
					]
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"comment": "Enum/type member: DSL_VIEWS.ShopMgmt, GENDER.Male",
					"name": "meta.property.access.enum.heliumrapid",
					"match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
					"captures": {
						"1": {
							"name": "entity.name.type.enum.heliumrapid"
						},
						"2": {
							"name": "punctuation.accessor.heliumrapid"
						},
						"3": {
							"name": "variable.other.enummember.heliumrapid"
						}
					}
				},
				{
					"comment": "Trigger context objects when not followed by member access",
					"name": "variable.language.trigger.heliumrapid",
					"match": "\\b(before|after)\\b"
				},
				{
					"name": "variable.other.readwrite.heliumrapid",
					"match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.heliumrapid",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.language.null.heliumrapid",
					"match": "\\b(null)\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.statement.heliumrapid",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.heliumrapid",
					"match": ","
				},
				{
					"name": "punctuation.separator.colon.heliumrapid",
					"match": ":"
				},
				{
					"name": "punctuation.definition.block.heliumrapid",
					"match": "\\{|\\}"
				},
				{
					"name": "punctuation.definition.array.heliumrapid",
					"match": "\\[|\\]"
				},
				{
					"name": "punctuation.definition.parameters.heliumrapid",
					"match": "\\(|\\)"
				}
			]
		},

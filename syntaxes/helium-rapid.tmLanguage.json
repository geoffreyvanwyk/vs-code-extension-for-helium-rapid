{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Helium Rapid",
	"scopeName": "source.rapid.helium",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#annotations"
		},
		{
			"include": "#storage-types"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.rapid.helium",
					"match": "//.*$"
				},
				{
					"name": "comment.block.rapid.helium",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"name": "comment.block.rapid.helium",
							"match": "\\*/"
						}
					]
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.rapid.helium",
					"match": "\\b(if|else|for|return)\\b"
				},
				{
					"name": "keyword.type.rapid.helium",
					"match": "\\b(object|enum|validator|unit)\\b"
				},
				{
					"name": "keyword.modifier.rapid.helium",
					"match": "\\b(persistent)\\b"
				},

				{
					"name": "keyword.operator.assignment.rapid.helium",
					"match": "\\b(is|as|in|via)\\b"
				},
				{
					"name": "keyword.other.rapid.helium",
					"match": "\\b(true|false|null)\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.rapid.helium",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.rapid.helium",
							"match": "\\\\."
						},
						{
							"name": "constant.character.escape.unicode.rapid.helium",
							"match": "\\\\u[0-9a-fA-F]{4}"
						},
						{
							"name": "constant.character.escape.unicode.rapid.helium",
							"match": "\\\\x[0-9a-fA-F]{2}"
						}
					]
				},
				{
					"name": "string.quoted.single.rapid.helium",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.rapid.helium",
							"match": "\\\\."
						},
						{
							"name": "constant.character.escape.unicode.rapid.helium",
							"match": "\\\\u[0-9a-fA-F]{4}"
						},
						{
							"name": "constant.character.escape.unicode.rapid.helium",
							"match": "\\\\x[0-9a-fA-F]{2}"
						}
					]
				},
				{
					"name": "string.quoted.template.rapid.helium",
					"begin": "`",
					"end": "`",
					"patterns": [
						{
							"name": "constant.character.escape.rapid.helium",
							"match": "\\\\."
						},
						{
							"name": "variable.other.template.rapid.helium",
							"begin": "\\$\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "#variables"
								},
								{
									"include": "#operators"
								}
							]
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.integer.hexadecimal.rapid.helium",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.integer.binary.rapid.helium",
					"match": "\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.integer.octal.rapid.helium",
					"match": "\\b0[oO]?[0-7]+\\b"
				},
				{
					"name": "constant.numeric.float.rapid.helium",
					"match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.decimal.rapid.helium",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.rapid.helium",
					"match": "\\+|-|\\*|/|%|\\*\\*"
				},
				{
					"name": "keyword.operator.assignment.rapid.helium",
					"match": "=|\\+=|-=|\\*=|/=|%=|\\*\\*=|<<=|>>=|&=|\\|=|\\^="
				},
				{
					"name": "keyword.operator.comparison.rapid.helium",
					"match": "==|!=|===|!==|<|>|<=|>="
				},
				{
					"name": "keyword.operator.logical.rapid.helium",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.rapid.helium",
					"match": "&|\\||\\^|~|<<|>>|>>>"
				},
				{
					"name": "keyword.operator.increment.rapid.helium",
					"match": "\\+\\+|--"
				},
				{
					"name": "keyword.operator.member.rapid.helium",
					"match": "\\.|\\?\\."
				},
				{
					"name": "keyword.operator.spread.rapid.helium",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.optional.rapid.helium",
					"match": "\\?"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.rapid.helium",
					"match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\s*\\("
				},
				{
					"name": "keyword.other.function.rapid.helium",
					"match": "\\b(function|=>)\\b"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.readwrite.rapid.helium",
					"match": "\\b[a-z_$][a-zA-Z0-9_$]*\\b"
				},
				{
					"name": "variable.language.this.rapid.helium",
					"match": "\\bthis\\b"
				},
				{
					"name": "variable.language.super.rapid.helium",
					"match": "\\bsuper\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.rapid.helium",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.language.null.rapid.helium",
					"match": "\\b(null|undefined)\\b"
				},
				{
					"name": "constant.language.numeric.rapid.helium",
					"match": "\\b(NaN|Infinity)\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.statement.rapid.helium",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.rapid.helium",
					"match": ","
				},
				{
					"name": "punctuation.separator.colon.rapid.helium",
					"match": ":"
				},
				{
					"name": "punctuation.definition.block.rapid.helium",
					"match": "\\{|\\}"
				},
				{
					"name": "punctuation.definition.array.rapid.helium",
					"match": "\\[|\\]"
				},
				{
					"name": "punctuation.definition.parameters.rapid.helium",
					"match": "\\(|\\)"
				}
			]
		},
		"storage-types": {
			"patterns": [
				{
					"name": "storage.type.primitive.rapid.helium",
					"match": "\\b(int|string|decimal|bool|date|datetime|uuid|void|blob)\\b"
				},
				{
					"name": "storage.type.object.rapid.helium",
					"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"annotations": {
			"patterns": [
				{
					"name": "meta.declaration.annotation.rapid.helium",
					"begin": "(@)([a-zA-Z][a-zA-Z0-9_]*)",
					"end": "(?=\\s|$)",
					"captures": {
						"1": {
							"name": "punctuation.definition.annotation.rapid.helium"
						},
						"2": {
							"name": "storage.type.annotation.rapid.helium"
						}
					},
					"patterns": [
						{
							"name": "meta.declaration.annotation.arguments.rapid.helium",
							"begin": "\\(",
							"end": "\\)",
							"patterns": [
								{
									"include": "#strings"
								},
								{
									"include": "#numbers"
								},
								{
									"include": "#variables"
								},
								{
									"include": "#functions"
								},
								{
									"name": "punctuation.separator.comma.rapid.helium",
									"match": ","
								}
							]
						}
					]
				}
			]
		}
	}
}
{
  "name": "language-support-for-helium-rapid",
  "displayName": "Language support for Helium Rapid",
  "description": "Provides language support for the domain-specific language of the Helium Rapid application platform.",
  "icon": "images/language-support-for-helium-rapid-icon.png",
  "version": "1.10.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./tsconfig.test.json && node out-test/symbolExtractor.test.js && node out-test/referenceFinder.test.js && node out-test/documentSymbols.test.js && node out-test/renameValidation.test.js && node out-test/completionProposals.test.js && node out-test/callContext.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "heliumrapid",
        "aliases": [
          "Helium Rapid",
          "Helium DSL",
          "Helium"
        ],
        "extensions": [
          ".mez"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "images/helium-rapid-light.png",
          "dark": "images/helium-rapid-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "heliumrapid",
        "scopeName": "source.heliumrapid",
        "path": "./syntaxes/heliumrapid.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json",
          "meta.embedded.block.sql": "sql"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.8.2"
  }
}
